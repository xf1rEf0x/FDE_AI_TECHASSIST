[Unit]
Description=TechAssist AI Streamlit app
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/techassist
EnvironmentFile=/opt/techassist/.env
ExecStart=/opt/techassist/venv/bin/streamlit run app.py --server.headless true --server.port 8501
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
