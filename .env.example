GOOGLE_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-2.0-flash
HUGGINGFACEHUB_API_TOKEN=your_hf_token_here
HUGGINGFACE_MODEL=HuggingFaceH4/zephyr-7b-beta

# Optional: only needed when deploying somewhere with an ephemeral filesystem
# (e.g. Streamlit Community Cloud). Leave unset for local dev — data/*.json
# files are used instead. Free tier: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: only needed for real vector-search RAG (HF embeddings + Upstash
# Vector). Leave unset to fall back to local keyword matching over the PDFs
# in rag/. Free tier: https://upstash.com
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=
